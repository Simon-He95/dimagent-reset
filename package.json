{
  "name": "dimagent-reset",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787 --local",
    "build": "pnpm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "oxlint src worker test vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply dim-reset --local",
    "db:migrate:remote": "wrangler d1 migrations apply dim-reset --remote",
    "stats:local": "wrangler d1 execute dim-reset --local --file ./scripts/report.sql",
    "stats:remote": "wrangler d1 execute dim-reset --remote --file ./scripts/report.sql",
    "deploy": "pnpm run build && wrangler deploy",
    "clean": "rimraf --glob dist .wrangler *.tsbuildinfo"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@phosphor-icons/vue": "^2.2.1",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "oxlint": "^1.68.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.2.12",
    "wrangler": "^4.162.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Simon-He95/dimagent-reset.git"
  }
}
